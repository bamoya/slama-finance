DATABASE_URL=
# Separate migration-owner connection; never give owner privileges to the API role.
MIGRATION_DATABASE_URL=
# Tests require a localhost database whose name ends in _test, never the app database.
TEST_DATABASE_URL=postgres://slama_test:slama_test@127.0.0.1:55439/slama_finance_test
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Comma-separated exact IPs of trusted reverse proxies. Empty ignores forwarded IPs.
# Restrict network access and overwrite forwarded headers at the public ingress.
TRUST_PROXY_IPS=
# Every site derives from one platform domain: apex (public), app. (owner portal), admin.,
# api. and <slug>. (organization workspace). The API serves /api/v1 on every host; browsers call
# it on their own origin, so there is no CORS. Production: bfinance.ma + https.
PLATFORM_DOMAIN=localhost:5173
PLATFORM_SCHEME=http
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=1000
DATABASE_POOL_SIZE=10
RATE_LIMIT_MAX=100
LOG_LEVEL=info
REDIS_URL=
API_BASE_URL=http://localhost:3000
UI_BASE_URL=http://localhost:5173
SESSION_TTL_DAYS=30
# Resend: configure all three together; required in production. Never commit real keys.
RESEND_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_URL=
# Local business and owner-account email is captured by Mailpit at http://localhost:8025.
# Without an explicit transport, development/test records only; production uses Resend.
# Both recording and local SMTP are rejected in production.
NOTIFICATION_TRANSPORT=smtp
# Local Mailpit only. Production must use resend; tests may use recording.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_POLL_MS=2000
REPORT_POLL_MS=10000
# Zero disables payload erasure; review retention before enabling it.
NOTIFICATION_PAYLOAD_RETENTION_DAYS=0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Private local development uploads; never expose as static public files.
MEDIA_ASSET_DIR=.local/media
S3_BUCKET=slama-media
# Local MinIO credentials ONLY; replace all S3 values for OCI production.
S3_ACCESS_KEY_ID=slama-local
S3_SECRET_ACCESS_KEY=slama-local-development-only

# Central SaaS owner accounts; leave disabled until reviewed migration/runtime grants are applied.
OWNER_AUTH_ENABLED=false

# SaaS administration (served on the admin. site). 32 random bytes, base64:
# openssl rand -base64 32. Admin sign-in returns 503 until set. Bootstrap admins with
# pnpm admin:create --email <email> --name <name> (password via ADMIN_PASSWORD or prompt).
ADMIN_TOTP_KEY=
