{
  "name": "@slama/api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "storage:local:init": "tsx scripts/storage-local.ts",
    "storage:local:check": "tsx scripts/storage-local.ts --check",
    "dev": "pnpm contracts:generate && tsx watch src/server.ts",
    "build": "pnpm contracts:generate && tsc && node scripts/copy-assets.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm contracts:generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "pnpm contracts:generate && vitest run && pnpm test:architecture && pnpm test:generator",
    "test:generator": "node --test scripts/generate-contracts.test.mjs",
    "test:architecture": "node --test eslint/architecture.test.mjs",
    "test:integration": "pnpm contracts:generate && vitest run --config vitest.integration.config.ts",
    "contract:check": "pnpm contracts:generate && vitest run tests/contract.test.ts tests/generated-contracts.test.ts",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:grant-sales-runtime": "tsx scripts/grant-sales-runtime.ts",
    "db:bootstrap-admin": "pnpm contracts:generate && tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bullmq": "^5.34.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.1.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.14",
    "nodemailer": "^10.0.14",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.4",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.17.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
