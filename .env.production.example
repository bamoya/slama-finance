# Reference only. Put real values in Coolify secrets or an uncommitted .env.production.
# Use three images published from the SAME commit; digest-pinned references are preferable.
API_IMAGE=ghcr.io/your-org/slama-finance-api:FULL_COMMIT_SHA
UI_IMAGE=ghcr.io/your-org/slama-finance-ui:FULL_COMMIT_SHA
RELEASE_IMAGE=ghcr.io/your-org/slama-finance-release:FULL_COMMIT_SHA

PUBLIC_ORIGIN=https://finance.example.com

# Create this volume deliberately before first deployment; never silently replace it.
POSTGRES_VOLUME_NAME=slama-finance-production-postgres
POSTGRES_OWNER_PASSWORD=
# Provision the restricted slama_runtime role separately. URL-encode password characters.
# Database name/service are fixed in infra/compose/docker-compose.production.yml.
DATABASE_URL=postgres://slama_runtime:URL_ENCODED_PASSWORD@postgres:5432/slama_finance
MIGRATION_DATABASE_URL=postgres://slama_owner:URL_ENCODED_OWNER_PASSWORD@postgres:5432/slama_finance

# Check subnet availability against the host/Coolify networks before deployment.
APPLICATION_SUBNET=172.30.84.0/24
UI_PROXY_IP=172.30.84.2
# Comma-separated exact IPs: UI_PROXY_IP AND the verified Coolify ingress hop(s).
# Leave blank until verified; this groups rate limits by proxy, not client, but rejects spoofing.
# Never set true, a subnet, or arbitrary client addresses. Recheck after proxy recreation.
TRUST_PROXY_IPS=

RESEND_API_KEY=
EMAIL_FROM=notifications@example.com
# Zero retains payloads; choose a policy deliberately before changing it.
NOTIFICATION_PAYLOAD_RETENTION_DAYS=0

# Private AWS S3 bucket; dedicated media credentials only (not backup credentials).
# OCI fallback: https://YOUR_NAMESPACE.compat.objectstorage.YOUR_REGION.oraclecloud.com
S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
